{
  "schema": 1,
  "id": "vitruvius",
  "name": "Vitruvius's Hoard",
  "purpose": "Software workbench with design/source projects, version-exact API documentation and existing reverse-engineering capabilities; independent modules under demand.",
  "capabilities": [
    "design-criterion-library",
    "design-rules",
    "style-catalog",
    "palette-catalog",
    "font-pairing-catalog",
    "html-render",
    "url-render",
    "screenshot-capture",
    "scroll-video-capture",
    "design-lint",
    "design-critique",
    "vision-critique",
    "render-diff",
    "design-tokens",
    "oklch-palettes",
    "tailwind-export",
    "css-export",
    "reference-gallery",
    "source-ingestion",
    "motion-compositions",
    "motion-timeline",
    "motion-mp4",
    "motion-html",
    "composition-revisions",
    "diagrams",
    "diagram-brand-profiles",
    "isometric-diagrams",
    "mermaid-import",
    "excalidraw-import",
    "drawio-import",
    "reference-collections",
    "original-html-patterns",
    "application-projects",
    "standalone-application-export",
    "typed-application-actions",
    "owned-local-previews",
    "owned-functional-page-checker",
    "explicit-page-behavior-criteria",
    "version-exact-api-docs",
    "native-api-checker",
    "source-environment-links",
    "retained-analysis-results",
    "existing-reverse-engineering"
  ],
  "placeholders": [
    "VITRUVIUS_DIR",
    "APP_URL",
    "TOKEN_FILE",
    "PYTHON",
    "DATA_DIR"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5191",
    "TOKEN_FILE": "{VITRUVIUS_DIR}/data/design/mcp-token",
    "PYTHON": "{VITRUVIUS_DIR}/venv/Scripts/python.exe",
    "DATA_DIR": "{VITRUVIUS_DIR}/data"
  },
  "app": {
    "url_default": "http://127.0.0.1:5191",
    "ui_url": "{APP_URL}",
    "health": {
      "path": "/api/health",
      "expect": {
        "service": "vitruvius-hoard"
      }
    },
    "identify": {
      "service": [
        "vitruvius-hoard"
      ],
      "title": [
        "vitruvius's hoard",
        "taller de dise\u00f1o de interfaces"
      ]
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": [
        "-I",
        "-m",
        "vitruvius_hoard"
      ],
      "cwd": "{VITRUVIUS_DIR}",
      "env": {
        "PORT_STRICT": "1",
        "VITRUVIUS_PORT": "5191",
        "VITRUVIUS_PROFILE_DIR": "{DATA_DIR}",
        "VITRUVIUS_TOKEN_FILE": "{TOKEN_FILE}"
      },
      "readiness": {
        "url": "{APP_URL}/api/health",
        "timeout_s": 30
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": [
      "-I",
      "-m",
      "mcp_server"
    ],
    "env": {
      "VITRUVIUS_URL": "{APP_URL}",
      "VITRUVIUS_TOKEN_FILE": "{TOKEN_FILE}",
      "VITRUVIUS_PROFILE_DIR": "{DATA_DIR}"
    },
    "optional_env": [
      "VITRUVIUS_BRIDGE_AUTOSTART",
      "VITRUVIUS_DATA_DIR"
    ]
  },
  "notes": "Three independent modules and automatic work start OFF. Cold110-tool discovery never instantiates factories/stores or workers. Global LLM uses exact Sparks selection through Faustus938. Theseus development is incomplete and paused by Luis due to usage; this incorporation does not complete its pending reverse-engineering scope.",
  "x-family": {
    "copilot": {
      "contract_version": "1.0",
      "info": "/api/copilot/info",
      "panel": "/api/copilot/panel.js",
      "proxy": "/api/copilot/proxy",
      "launcher": "/api/copilot/launcher.js"
    }
  }
}
