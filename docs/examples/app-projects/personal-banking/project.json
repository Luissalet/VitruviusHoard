          "name": "origen",
          "label": "Desde",
          "type": "ref",
          "collection": "cuentas"
        },
        {
          "name": "contacto",
          "label": "Contacto",
          "type": "ref",
          "collection": "contactos",
          "required": false
        },
        {
          "name": "destino",
          "label": "Cuenta propia de destino",
          "type": "ref",
          "collection": "cuentas",
          "required": false
        },
        {
          "name": "iban",
          "label": "IBAN de destino",
          "type": "text",
          "format": "iban",
          "required": false
        },
        {
          "name": "beneficiario",
          "label": "Titular",
          "type": "text",
          "required": false
        },
        {
          "name": "importe_cent",
          "label": "Importe (céntimos)",
          "type": "integer",
          "min": 1
        },
        {
          "name": "concepto",
          "label": "Concepto",
          "type": "text"
        },
        {
          "name": "fecha",
          "label": "Fecha",
          "type": "text"
        }
      ],
      "exactly_one": [
        "contacto",
        "destino",
        "iban"
      ],
      "lookups": {
        "desde": {
          "collection": "cuentas",
          "field": "id",
          "equals": {
            "input": "origen"
          }
        },
        "persona": {
          "collection": "contactos",
          "field": "id",
          "equals": {
            "input": "contacto"
          }
        },
        "propia_por_iban": {
          "collection": "cuentas",
          "field": "iban",
          "equals": {
            "input": "iban"
          }
        },
        "hacia": {
          "collection": "cuentas",
          "field": "id",
          "equals": {
            "coalesce": [
              {
                "input": "destino"
              },
              {
                "record": "propia_por_iban",
                "field": "id"
              }
            ]
          }
        }
      },
      "different": [
        {
          "input": "origen"
        },
        {
          "record": "hacia",
          "field": "id"
        }
      ],
      "effects": [
        {
          "op": "adjust",
          "collection": "cuentas",
          "id": {
            "input": "origen"
          },
          "field": "disponible_cent",
          "amount": {
            "negate": {
              "input": "importe_cent"
            }
          }
        },
        {
          "op": "adjust",
          "collection": "cuentas",
          "id": {
            "input": "origen"
          },
          "field": "saldo_cent",
          "amount": {
            "negate": {
              "input": "importe_cent"
            }
          }
        },
        {
          "op": "create",
          "collection": "movimientos",
          "values": {
            "cuenta": {
              "input": "origen"
            },
            "fecha": {
              "input": "fecha"
            },
            "concepto": {
              "input": "concepto"
            },
            "contraparte": {
              "coalesce": [
                {
                  "record": "persona",
                  "field": "nombre"
                },
                {
                  "record": "hacia",
                  "field": "nombre"
                },
                {
                  "input": "beneficiario"
                },
                {
                  "input": "iban"
                }
              ]
            },
            "importe_cent": {
              "negate": {
                "input": "importe_cent"
              }
            },
            "categoria": "Transferencia"
          }
        },
        {
          "op": "adjust",
          "when": {
            "record": "hacia",
            "field": "id"
          },
          "collection": "cuentas",
          "id": {
            "record": "hacia",
            "field": "id"
          },
          "field": "disponible_cent",
          "amount": {
            "input": "importe_cent"
          }
        },
        {
          "op": "adjust",
          "when": {
            "record": "hacia",
            "field": "id"
          },
          "collection": "cuentas",
          "id": {
            "record": "hacia",
            "field": "id"
          },
          "field": "saldo_cent",
          "amount": {
            "input": "importe_cent"
          }
        },
        {
          "op": "create",
          "when": {
            "record": "hacia",
            "field": "id"
          },
          "collection": "movimientos",
          "values": {
            "cuenta": {
              "record": "hacia",
              "field": "id"
            },
            "fecha": {
              "input": "fecha"
            },
            "concepto": {
